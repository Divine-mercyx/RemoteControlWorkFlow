PORT=8080
# Public URL users open (join links are built from it)
PUBLIC_URL=https://support.example.com
# Secret the technician viewer / admin backend uses to create sessions
TECH_API_KEY=change-me
# Join link lifetime and maximum session length (seconds)
LINK_TTL_SECONDS=600
SESSION_MAX_SECONDS=7200
# STUN / TURN. Needed when the technician and user are on different networks.
# Option A: your own coturn with use-auth-secret (set TURN_SECRET)
# Option B: a hosted relay service (set TURN_USERNAME and TURN_CREDENTIAL instead of TURN_SECRET)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_SECRET=change-me-too
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Allowed browser origins (e.g. the Nolt admin frontend)
CORS_ORIGINS=
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
# Built Windows app (from the "Windows agent" GitHub Actions artifact)
AGENT_WINDOWS_EXE=/srv/nolt/NoltSupport.exe
